generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ExamType {
  TECH
  PM
  FINANCE
  UPSC
  IIT_JEE
  NEET
  SCHOOL
}

model User {
  id           String          @id @default(cuid())
  email        String?         @unique
  passwordHash String?
  displayName  String
  isGuest      Boolean         @default(false)
  examType     ExamType        @default(SCHOOL)
  classLevel   Int?
  language     String          @default("en")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  progress     TopicProgress[]
  bookmarks    Bookmark[]
}

model Subject {
  id         String    @id
  name       String
  labelEn    String
  labelHi    String
  examType   ExamType  @default(SCHOOL)
  classLevel Int?
  iconName   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  chapters   Chapter[]
}

model Chapter {
  id        String   @id
  subjectId String
  titleEn   String
  titleHi   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id             String          @id
  chapterId      String
  title          String
  difficulty     String          @default("medium")
  cheatSheetJson String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  chapter        Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  reels          Reel[]
  quizzes        QuizQuestion[]
  flashcards     Flashcard[]
  progress       TopicProgress[]
  bookmarks      Bookmark[]
}

model Reel {
  id                  String   @id
  topicId             String
  title               String
  videoUrl            String
  durationSec         Int      @default(45)
  keyTakeaway         String?
  summaryNotesJson    String?
  architectureDiagram String?
  interviewPitch      String?
  pitfallsJson        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  topic               Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model QuizQuestion {
  id              String   @id
  topicId         String
  reelId          String?
  text            String
  optionsJson     String
  correctOptionId String
  explanation     String?
  order           Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topic           Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id            String   @id
  topicId       String
  frontQuestion String
  backAnswer    String
  bulletsJson   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model TopicProgress {
  id                String   @id @default(cuid())
  userId            String
  topicId           String
  completionPercent Int      @default(0)
  quizScore         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic             Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  reelId    String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId, reelId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventName String
  payload   String
  createdAt DateTime @default(now())
}
